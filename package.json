{
  "name": "spinoscopy-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "tsx scripts/generate-dakota-manifest.ts && next build",
    "dakota:manifest": "tsx scripts/generate-dakota-manifest.ts",
    "frontier:sync": "tsx --env-file=.env.local scripts/sync-ai-frontier-catalog.ts",
    "frontier:backfill-preview": "tsx --env-file=.env.local scripts/preview-ai-frontier-backfill.ts",
    "telegram:bot": "tsx scripts/telegram-bot.ts",
    "telegram:bot:force": "DAKOTA_TELEGRAM_ALLOW_GATEWAY_CONFLICT=1 tsx scripts/telegram-bot.ts",
    "ledger:schema": "tsx --env-file=.env.local scripts/dakota-ledger-schema.ts",
    "ledger:sync": "tsx --env-file=.env.local scripts/dakota-ledger-sync.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.45",
    "@ai-sdk/react": "^3.0.96",
    "@google/genai": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "ably": "^2.23.0",
    "ai": "^6.0.92",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "nodemailer": "^6.10.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
