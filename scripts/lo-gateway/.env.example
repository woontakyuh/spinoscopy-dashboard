# Required: Notion database IDs for Lo profile and memory tracking
NOTION_LO_PROFILE_DB_ID=3b2908af-25b9-81f8-96e5-d37a06535e07
NOTION_LO_MEMORY_DB_ID=3b2908af-25b9-81d1-8218-d9a54b2012c9

# Required: absolute path to the canonical BJJ markdown repository.
BJJ_GRAPH_ROOT=/Users/you/workspace/BJJ

# Required: random shared secret, at least 16 characters. Do not commit its value.
LO_GATEWAY_HMAC_SECRET=replace-with-a-random-secret

# Required only for the authenticated Hermes conversation endpoint. The provider
# request uses store=false and the gateway never persists conversation text.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional; the process always binds to 127.0.0.1.
LO_GATEWAY_PORT=4318
